# =========================================================================
# CogniMirror Backend Environment Configuration (Example)
# Copy this file to .env and replace the placeholders with your actual keys.
# =========================================================================

# FastAPI Settings
PROJECT_NAME="CogniMirror"

# JWT & Authentication
# SECRET_KEY is used to sign JSON Web Tokens. Provide a secure, random string.
# JWT_SECRET will be used as a fallback if SECRET_KEY is not defined.
SECRET_KEY="your_secure_random_production_secret_key_here"
JWT_SECRET=""

# Database URL
# Defaults to local SQLite. In production, provide your PostgreSQL connection string.
# Example: postgresql://postgres:password@localhost:5432/cognimirror
DATABASE_URL="sqlite:///./cognimirror.db"

# CORS Allowed Origins
# Comma-separated list of origins allowed to make requests to this backend.
# In production, set this to your frontend URL.
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Gemini AI Service Configuration
# Get your Gemini API Key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

# Sarvam AI STT Service Configuration
# Get your Sarvam API Key from Sarvam AI: https://www.sarvam.ai/
SARVAM_API_KEY="your_sarvam_api_key_here"

# Google OAuth Credentials (Optional)
# If using Google OAuth features, configure client ID and secret.
GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
